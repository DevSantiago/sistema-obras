# Base de datos PostgreSQL
APP_ENV="development"
DATABASE_URL="postgresql://usuario:password@localhost:5432/sistema_obras"

# Autenticación
JWT_SECRET="reemplace-con-un-secreto-largo-y-aleatorio"
APP_BASE_URL="http://localhost:3000"

# Almacenamiento: local para desarrollo, s3 para staging y producción
STORAGE_PROVIDER="local"

# Amazon S3 (obligatorias cuando STORAGE_PROVIDER=s3)
AWS_REGION="us-east-1"
AWS_S3_BUCKET="sistema-obras-stg-archivos"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""

# Compatibilidad opcional con proveedores que implementan la API S3
# AWS_S3_ENDPOINT=""
# AWS_S3_FORCE_PATH_STYLE="false"

# WhatsApp Business Platform
WHATSAPP_ENABLED="false"
WHATSAPP_GRAPH_API_VERSION="reemplace-version-vigente"
WHATSAPP_WABA_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_PHONE_NUMBER=""
WHATSAPP_APP_ID=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_PROCESSOR_TOKEN=""
WHATSAPP_MAX_ATTEMPTS="3"
WHATSAPP_BATCH_SIZE="10"
WHATSAPP_RETRY_MINUTES="5"
WHATSAPP_SENDING_TIMEOUT_MINUTES="10"
WHATSAPP_REQUEST_TIMEOUT_MS="15000"
WHATSAPP_TEMPLATE_APROBACION_NIVEL_1=""
WHATSAPP_TEMPLATE_APROBACION_NIVEL_2=""
WHATSAPP_TEMPLATE_DEVOLUCION_APROBADOR_1=""
WHATSAPP_TEMPLATE_DEVOLUCION_SOLICITANTE=""
WHATSAPP_TEMPLATE_PROGRAMADA_PAGO=""
WHATSAPP_TEMPLATE_LANGUAGE="es_CO"

# Web Push (generar un juego independiente por ambiente con npm run push:generate-keys)
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="https://dimensiones.cloud"
PUSH_ENABLED="false"
PUSH_PROCESSOR_TOKEN=""
PUSH_MAX_ATTEMPTS="3"
PUSH_BATCH_SIZE="20"
PUSH_RETRY_MINUTES="5"
PUSH_SENDING_TIMEOUT_MINUTES="10"
PUSH_REQUEST_TIMEOUT_MS="15000"
PUSH_TTL_SECONDS="3600"
