# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/sistema_obras"

# Autenticación
JWT_SECRET="reemplace-con-un-secreto-largo-y-aleatorio"

# Almacenamiento: local para desarrollo, s3 para staging y producción
STORAGE_PROVIDER="local"

# Amazon S3 (obligatorias cuando STORAGE_PROVIDER=s3)
AWS_REGION="us-east-1"
AWS_S3_BUCKET="sistema-obras-stg-archivos"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""

# Compatibilidad opcional con proveedores que implementan la API S3
# AWS_S3_ENDPOINT=""
# AWS_S3_FORCE_PATH_STYLE="false"
